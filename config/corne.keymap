#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>

#define ____ &none

/ {
        keymap {
                compatible = "zmk,keymap";

                default_layer {
// -----------------------------------------------------------------------------------------
// |  TAB |  Q  |  W  |  E  |  R  |  T  |   |  Y  |  U   |  I  |  O  |  P  | BKSP |
// | CTRL |  A  |  S  |  D  |  F  |  G  |   |  H  |  J   |  K  |  L  |  ;  |  '   |
// | SHFT |  Z  |  X  |  C  |  V  |  B  |   |  N  |  M   |  ,  |  .  |  /  | ESC  |
//                    | GUI | LWR | SPC |   | ENT | RSE  | ALT |
                        display-name = "Base";
                        bindings = <
   &kp Y &kp U &kp I &kp O &kp P &kp BSPC   ____ ____ ____ ____ ____ ____
   &kp H &kp J &kp K &kp L &kp SEMI &kp SQT  ____ ____ ____ ____ ____ ____
   &kp N &kp M &kp COMMA &kp DOT &kp FSLH &kp ESC   ____ ____ ____ ____ ____ ____
                  &kp RET &mo 2 &kp RALT   ____ ____ ____
                        >;
                };
                lower_layer {
// -----------------------------------------------------------------------------------------
// |  TAB |  1  |  2  |  3  |  4  |  5  |   |  6  |  7  |  8  |  9  |  0  | BKSP |
// | BTCLR| BT1 | BT2 | BT3 | BT4 | BT5 |   | LFT | DWN |  UP | RGT |     |      |
// | SHFT |     |     |     |     |     |   |     |     |     |     |     |      |
//                    | GUI |     | SPC |   | ENT |     | ALT |
                        display-name = "Lower";
                        bindings = <
   &kp N6   &kp N7   &kp N8 &kp N9 &kp N0 &kp BSPC   ____ ____ ____ ____ ____ ____
   &kp LEFT &kp DOWN &kp UP &kp RIGHT &trans &trans   ____ ____ ____ ____ ____ ____
   &trans   &trans   &trans &trans    &trans &trans   ____ ____ ____ ____ ____ ____
                          	        &kp RET      &trans       &kp RALT      ____ ____ ____
                        >;
                };

                raise_layer {
// -----------------------------------------------------------------------------------------
// |  TAB |  !  |  @  |  #  |  $  |  %  |   |  ^  |  &  |  *  |  (  |  )  | BKSP |
// | CTRL |     |     |     |     |     |   |  -  |  =  |  [  |  ]  |  \  |  `   |
// | SHFT |     |     |     |     |     |   |  _  |  +  |  {  |  }  | "|" |  ~   |
//                    | GUI |     | SPC |   | ENT |     | ALT |
                        display-name = "Raise";
                        bindings = <
   &kp CARET &kp AMPS &kp KP_MULTIPLY &kp LPAR &kp RPAR &kp BSPC   ____ ____ ____ ____ ____ ____
   &kp MINUS &kp EQUAL &kp LBKT &kp RBKT &kp BSLH &kp GRAVE   ____ ____ ____ ____ ____ ____
   &kp UNDER &kp PLUS &kp LBRC &kp RBRC &kp PIPE &kp TILDE   ____ ____ ____ ____ ____ ____
                     	     &kp RET &trans   &kp RALT   ____   ____    ____
                        >;
                };

                extra_1 {
                        status = "reserved";
                };

                extra_2 {
                        status = "reserved";
                };

                extra_3 {
                        status = "reserved";
                };
        };
};
